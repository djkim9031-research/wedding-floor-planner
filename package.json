{
  "name": "wedding-planner",
  "private": true,
  "version": "1.0.0",
  "description": "Wedding venue floor planner — 3D layout, cloth drape, sun & sky, Blender renders",
  "author": "DJ Kim",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa:shots": "node scripts/qa/shots.mjs",
    "qa:diff": "node scripts/qa/diff.mjs",
    "typecheck:electron": "tsc -p electron",
    "electron:build": "npm run build && node scripts/build-electron.mjs",
    "electron:start": "npm run electron:build && electron .",
    "dist:mac": "npm run electron:build && electron-builder --mac dmg --x64",
    "icons": "node build/make-icons.mjs"
  },
  "dependencies": {
    "oidn-web": "0.4.0",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "xatlas-web": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "pixelmatch": "^6.0.0",
    "playwright-core": "^1.56.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
